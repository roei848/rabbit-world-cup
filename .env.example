# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase console → Project settings → General → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# api-football.com — get your key at api-football.com/dashboard
VITE_API_FOOTBALL_KEY=

# Cloud Functions environment variables (set via Firebase CLI):
# firebase functions:secrets:set SENDGRID_API_KEY
# firebase functions:config:set app.url="https://your-app.web.app"
