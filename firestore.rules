rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    // Returns true when the caller is authenticated.
    function isAuthed() {
      return request.auth != null;
    }

    // Returns true when the caller's user doc has isAdmin == true.
    function isAdmin() {
      return isAuthed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ─── /users/{uid} ────────────────────────────────────────────────────────
    // Read self, or any user who shares at least one league with the caller.
    // Write self only — but only the allowed profile fields, or append-only leagueIds.
    // Admin may read and write any user document.
    match /users/{uid} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin() ||
        resource.data.leagueIds.hasAny(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueIds
        )
      );

      // Self-writes: only displayName/photoURL may be changed, OR leagueIds may be appended (no removals).
      allow write: if isAuthed() && request.auth.uid == uid && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leagueIds']) &&
          request.resource.data.leagueIds.hasAll(resource.data.leagueIds)
        )
      );

      // Admin writes: any field.
      allow write: if isAdmin();
    }

    // ─── /picks/{uid}/matches/{matchId} ──────────────────────────────────────
    // Self read+write only, and only while the corresponding match is unlocked.
    // Admin may read any pick.
    match /picks/{uid}/matches/{matchId} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin()
      );

      allow write: if isAuthed() &&
        request.auth.uid == uid &&
        request.resource.data.userId == uid &&
        get(/databases/$(database)/documents/matches/$(matchId)).data.locked == false;
    }

    // ─── /matches/{matchId} ──────────────────────────────────────────────────
    // Public read for authenticated users.
    // No client writes — Cloud Functions use Admin SDK (bypasses rules).
    match /matches/{document=**} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── /leaderboard/** ─────────────────────────────────────────────────────
    // Public read for authenticated users (covers all depths: league doc + entries).
    // No client writes — Cloud Functions use Admin SDK.
    match /leaderboard/{document=**} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── /leagues/{leagueId} ─────────────────────────────────────────────────
    // Any authenticated user may read (needed for code-based lookup before joining).
    // Self-join: authenticated user may append only their own uid to memberIds.
    // Only admins may perform other writes.
    match /leagues/{leagueId} {
      allow read: if isAuthed();

      // Self-join: only add request.auth.uid to memberIds (no removals, no other field changes,
      // and exactly one element is added per write — prevents bulk-adding foreign UIDs).
      allow update: if isAuthed() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        request.resource.data.memberIds.hasAll([request.auth.uid]);

      allow write: if isAdmin();
    }

    // ─── /bonusPicks/{uid} ───────────────────────────────────────────────────
    // Self read+write only, and only before the tournament has started.
    // Admin may read all.
    match /bonusPicks/{uid} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin()
      );

      allow write: if isAuthed() &&
        request.auth.uid == uid &&
        request.resource.data.userId == uid &&
        request.time <
          get(/databases/$(database)/documents/settings/system).data.tournamentStartAt;
    }

    // ─── /settings/{document} ────────────────────────────────────────────────
    // Any authenticated user may read settings.
    // Only admins may write.
    match /settings/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─── /invites/{token} ────────────────────────────────────────────────────
    // Unauthenticated get is allowed — the secret token IS the access control
    // (bearer access: only the invite link holder knows the token).
    // Listing requires admin (prevents enumeration).
    // Only admins may write.
    match /invites/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── /auditLog/{logId} ───────────────────────────────────────────────────
    // Admin read only.
    // No client writes — Cloud Functions use Admin SDK.
    match /auditLog/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

  }
}
