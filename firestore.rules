rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    // Returns true when the caller is authenticated.
    function isAuthed() {
      return request.auth != null;
    }

    // Returns true when the caller's user doc has isAdmin == true.
    function isAdmin() {
      return isAuthed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Returns the match document data for the given matchId.
    // Firestore rules memoize get() calls with the same path within the same
    // request, so two calls to matchDoc(matchId) count as one read.
    function matchDoc(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // ─── /users/{uid} ────────────────────────────────────────────────────────
    // Read self, or any user who shares at least one league with the caller.
    // Write self only — but only displayName/photoURL (profile fields).
    // leagueIds is now managed exclusively by the joinLeague Cloud Function
    // (Admin SDK bypasses rules), so client writes to leagueIds are removed.
    // Admin may read and write any user document.
    match /users/{uid} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin() ||
        resource.data.leagueIds.hasAny(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueIds
        )
      );

      // Self-writes: only displayName and photoURL may be changed.
      allow write: if isAuthed() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL']);

      // Admin writes: any field.
      allow write: if isAdmin();
    }

    // ─── /picks/{uid}/matches/{matchId} ──────────────────────────────────────
    // Self read+write only, and only while the corresponding match is unlocked
    // and before its lockAt time. Admin may read any pick.
    // Field whitelist prevents clients from writing scoring fields.
    match /picks/{uid}/matches/{matchId} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin()
      );

      allow write: if isAuthed() &&
        request.auth.uid == uid &&
        request.resource.data.userId == uid &&
        request.resource.data.matchId == matchId &&
        request.resource.data.keys().hasOnly(['userId', 'matchId', 'homeGoals', 'awayGoals', 'submittedAt']) &&
        request.resource.data.homeGoals is int &&
        request.resource.data.homeGoals >= 0 &&
        request.resource.data.homeGoals <= 20 &&
        request.resource.data.awayGoals is int &&
        request.resource.data.awayGoals >= 0 &&
        request.resource.data.awayGoals <= 20 &&
        matchDoc(matchId).locked == false &&
        request.time < matchDoc(matchId).lockAt;
    }

    // ─── /matches/{matchId} ──────────────────────────────────────────────────
    // Public read for authenticated users.
    // No client writes — Cloud Functions use Admin SDK (bypasses rules).
    match /matches/{document=**} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── /leaderboard/** ─────────────────────────────────────────────────────
    // Public read for authenticated users (covers all depths: league doc + entries).
    // No client writes — Cloud Functions use Admin SDK.
    match /leaderboard/{document=**} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── /leagues/{leagueId} ─────────────────────────────────────────────────
    // Any authenticated user may read (needed for code-based lookup before joining).
    // The self-join update rule has been removed: joinLeague is now a Cloud Function
    // that uses Admin SDK, so no client writes to memberIds are needed.
    // Only admins may write.
    match /leagues/{leagueId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─── /bonusPicks/{uid} ───────────────────────────────────────────────────
    // Self read+write only, and only before the tournament has started.
    // Field whitelist prevents clients from writing unexpected fields.
    // Admin may read all.
    match /bonusPicks/{uid} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin()
      );

      allow write: if isAuthed() &&
        request.auth.uid == uid &&
        request.resource.data.userId == uid &&
        request.resource.data.keys().hasOnly(['userId', 'topScorer', 'worldCupWinner']) &&
        request.time <
          get(/databases/$(database)/documents/settings/system).data.tournamentStartAt;
    }

    // ─── /settings/{document} ────────────────────────────────────────────────
    // Any authenticated user may read settings.
    // Only admins may write.
    match /settings/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─── /invites/{token} ────────────────────────────────────────────────────
    // Unauthenticated get is allowed — the secret token IS the access control
    // (bearer access: only the invite link holder knows the token).
    // Listing requires admin (prevents enumeration).
    // Only admins may write.
    match /invites/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── /auditLog/{logId} ───────────────────────────────────────────────────
    // Admin read only.
    // No client writes — Cloud Functions use Admin SDK.
    match /auditLog/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

  }
}
